# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
LOG_LEVEL=info
PORT=3001

# PostgreSQL (local docker-compose defaults)
DATABASE_URL=postgresql://mcp:mcp@localhost:5432/mcp_ops

# Shared secret between AI client and MCP server
MCP_SERVER_SECRET=dev-secret-change-me

# AI client
MCP_SERVER_URL=http://localhost:3001/mcp
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
